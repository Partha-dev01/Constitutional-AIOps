{
  "name": "constitutional-aiops-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:live": "playwright test --config=playwright.config.live.ts",
    "test:e2e:live:headed": "playwright test --config=playwright.config.live.ts --headed",
    "test:e2e:schema": "playwright test --config=playwright.config.schema.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.89",
    "@tanstack/react-query": "^5.108.2",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
