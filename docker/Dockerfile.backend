# Constitutional AIOps - Backend Dockerfile
# Python FastAPI application

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
# Optional CPU-only torch for GPU-less deploys (the lite/self-host tier). When
# TORCH_INDEX_URL is set (docker-compose.lite.yml passes the PyTorch CPU wheel
# index), torch installs from it FIRST, so the requirements.txt `torch` pin is
# already satisfied and pip does NOT pull the multi-GB CUDA build + nvidia-cu*
# stack. sentence-transformers / bert-score then run on CPU torch (all-MiniLM
# works fine on CPU). Empty default = unchanged full/GPU build (CUDA torch).
ARG TORCH_INDEX_URL=""
RUN if [ -n "$TORCH_INDEX_URL" ]; then \
        pip install --no-cache-dir torch --index-url "$TORCH_INDEX_URL"; \
    fi
RUN pip install --no-cache-dir -r requirements.txt

# Lite tier only: pre-download the all-MiniLM-L6-v2 embedding model into the
# image's default Hugging Face cache so the FIRST semantic-memory operation after
# a cold wake reads it off disk instead of blocking on a ~90MB HF download. This
# uses the SAME unpinned call the runtime makes (embedding_service._load_model),
# so the runtime resolves the identical cached snapshot — the download is simply
# moved to build time. Guarded exactly like the torch install above: an empty
# TORCH_INDEX_URL (the full/GPU build) makes it a no-op, so that image is
# unchanged and never reaches out to Hugging Face at build.
RUN if [ -n "$TORCH_INDEX_URL" ]; then \
        python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"; \
    fi

# Copy application code
COPY src/ ./src/
COPY configs/ ./configs/
# Seeded benchmark datasets + results (app-facing mirror of the research corpus,
# produced by scripts/seed_benchmark_data.py). Ships so the Benchmark page is
# populated; the read-only benchmark/ corpus itself is intentionally NOT copied.
COPY data/ ./data/

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

# Run application
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
