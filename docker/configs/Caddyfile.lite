# Constitutional AIOps — LITE edge Caddyfile (5c WS3).
#
# Trimmed edge for the lite profile: backend + frontend only. NO /grafana route
# and NO /ingest telemetry routes, because Grafana and the LGTM stores are not
# part of lite. One public host, path-routed, automatic Let's Encrypt TLS.
#
# The access-log-to-stdout block is what aws/idle-check.sh greps ("handled
# request") to measure external liveness for sleep-when-idle — keep it.
#
# Env (from .env via docker-compose): APP_DOMAIN, ACME_EMAIL.

{
	email {$ACME_EMAIL}
	# Single-Caddy topology: no CDN/LB in front, so no inbound peer is a trusted
	# proxy — Caddy treats the connecting client as the real client (mirrors the
	# full Caddyfile's XFF hardening).
	servers {
		# Trust private ranges (plain Caddy-only self-host) PLUS any CDN
		# origin-facing ranges passed in CF_ORIGIN_RANGES (empty for a plain
		# self-host). When a CDN like CloudFront fronts the app, its origin IPs
		# MUST be trusted here or Caddy discards the CDN's X-Forwarded-For and the
		# app sees the CDN IP as the client, collapsing the per-IP login throttle.
		# Pair with TRUSTED_PROXY_HOPS on the backend (2 behind a CDN, else 1).
		trusted_proxies static private_ranges {$CF_ORIGIN_RANGES}
		client_ip_headers X-Forwarded-For
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Public OSS app: allow search indexing, but keep it out of AI
		# training/dataset crawls. Enforced (unlike advisory robots.txt).
		X-Robots-Tag "noai, noimageai"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ws: wss: https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}

# APP_DOMAIN is the public host. ORIGIN_DOMAIN (optional, empty for a plain
# self-host) is a 2nd hostname a CDN uses to reach this box directly, so Caddy
# must also hold its cert for the CDN->origin TLS handshake (the CDN's origin SNI
# is that hostname). Both names route to the same handlers below. An empty
# ORIGIN_DOMAIN expands to nothing, leaving a valid single-domain site.
{$APP_DOMAIN} {$ORIGIN_DOMAIN} {
	encode zstd gzip

	# Access log to stdout — aws/idle-check.sh reads this to detect external
	# traffic (sleep-when-idle). Do NOT remove.
	log {
		output stdout
		format console
	}

	# Backend REST API. The app's own session auth is the gate (AUTH_REQUIRED).
	@api path /api/*
	handle @api {
		import security_headers
		reverse_proxy backend:8000 {
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}

	# WebSocket stream (app-layer WS_TOKEN / session-cookie guarded in the backend).
	@ws path /ws
	handle @ws {
		import security_headers
		reverse_proxy backend:8000 {
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}

	# Interactive API reference: Swagger UI (/docs), ReDoc (/redoc) and the
	# OpenAPI spec (/openapi.json), served by the backend only when it runs with
	# AIOPS_ENABLE_DOCS=true. Swagger/ReDoc load their JS+CSS from the jsdelivr
	# CDN, so these routes get their OWN relaxed CSP — the strict app CSP above
	# would block the CDN and render a blank docs page.
	@docs path /docs /docs/* /redoc /redoc/* /openapi.json
	handle @docs {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Robots-Tag "noai, noimageai"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: https://fastapi.tiangolo.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
			-Server
		}
		reverse_proxy backend:8000 {
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}

	# SPA — everything else.
	handle {
		import security_headers
		reverse_proxy frontend:3000
	}
}
