# Build
frontend/build/
frontend/dist/
*.bak

# Neo4j data
neo4j_data/
# Top-level data/ excluded by default (catches downloaded/generated stuff).
# NOTE: ignore the *contents* (/data/*), not the dir itself, so a negation can
# re-include a single subtree without un-ignoring all of data/.
/data/*
# ...but DO track the seeded, app-facing benchmark mirror (datasets + results)
# produced by scripts/seed_benchmark_data.py so it ships in the backend image.
!/data/benchmark/
# Note: benchmark/data/ no longer exists (removed at L5222 of session-2 transcript).

# Temporary
tmp/
temp/
*.tmp

# SSH Keys (protect private key, allow public key)
.ssh/jarvis_labs_key
!.ssh/jarvis_labs_key.pub

# Benchmark raw datasets (5.5GB+ - download via scripts).
# Use /* + negate-README pattern so README.md is trackable while the data files are not.
benchmark/raw/*
!benchmark/raw/README.md
benchmark/datasets/raw/
# Both patterns active during 2026-05-20 reorg transition; remove the legacy line once reorg complete + verified.

# Playwright test artifacts
frontend/playwright-report/
frontend/playwright-report-live/
frontend/playwright-report-local/
frontend/playwright-report-graph/
frontend/playwright-report-schema/
frontend/test-results/
frontend/e2e/__screenshots__/
frontend/e2e/__console__/
.playwright-mcp/

# Session scratch scripts (must never reach the frozen benchmark artifact)
benchmark/final/audit/**/_tmp_*.py

# Nested project copy (tarball extraction artifact)
constitutional-aiops/

# Windows artifacts
nul

# LaTeX build intermediates (keep .tex and .pdf, exclude rebuildable artifacts)
*.aux
*.bbl
*.blg
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# Runs directory (per-experiment outputs created during benchmarks)
runs/

# Dataset preparation progress markers (transient, script-generated)
benchmark/.progress.json
benchmark/.benchmark_step2_complete
benchmark/.benchmark_step*

# Local benchmark results (transient overwrite by test runs — canonical results in benchmark/final/)
benchmark/archive/results_local/
benchmark/results/
# Both patterns active during 2026-05-20 reorg transition; remove the legacy line once reorg complete + verified.

# Distribution archives (built by scripts/archive.sh)
dist/

# Graph snapshots (LFS-tracked, but exclude from accidental plain-git stage)
# Note: actual *.dump files use LFS via .gitattributes; this just keeps a clean tree


# Local-only scratch: proofs, backups, archives, old creds. NEVER committed.
/_local/

# --- Pre-public exposure sweep (2026-09-08): internal/dev-only, kept local ---
# AI-assistant dev instructions; local dev still reads the local copy.
/CLAUDE.md
# Internal dev session logs (RELEASES.md is the public-facing changelog).
docs/CHECKLIST.md
docs/SESSION_STATE.md
docs/ISSUES.md
# Orphaned dev-era screenshots (product shots live under frontend/ & marketing/public).
/screenshots/
# Playwright runner cache at repo root (.playwright-mcp/ + frontend/test-results already ignored).
/test-results/
