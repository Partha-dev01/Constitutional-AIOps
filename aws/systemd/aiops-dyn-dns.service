# aiops-dyn-dns.service — one-shot on boot: UPSERT the box's public A record.
# The lite tier runs with NO Elastic IP (cost), so the public IPv4 changes on
# every wake. This keeps aiops-node.<domain> pointed at the live box so the
# wake-on-visit front door's 302 lands on a reachable address. Pairs with the
# CloudWatch/idle-check sleep-when-idle half.
#
# Install ON the VM:
#   sudo cp aws/systemd/aiops-dyn-dns.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now aiops-dyn-dns.service
# (Assumes the repo is reachable at /opt/aiops — symlink it if it lives elsewhere.)
[Unit]
Description=Constitutional AIOps - dynamic DNS (Route53 A record) on boot
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/aiops/aws/dyn-dns.sh

[Service]
Type=oneshot
# Real HOSTED_ZONE_ID + RECORD_NAME live in this box-local file (NOT committed):
#   HOSTED_ZONE_ID=...
#   RECORD_NAME=app-node.example.com
EnvironmentFile=-/etc/aiops/dyn-dns.env
ExecStart=/opt/aiops/aws/dyn-dns.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
