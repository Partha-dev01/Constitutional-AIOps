# Constitutional AIOps - PRODUCTION environment template (AWS VM)
# Copy to .env.production (gitignored) and fill in real values, then deploy with:
#
#   docker compose --env-file .env.production \
#     -f docker-compose.yml -f docker/docker-compose.production.yml up -d
#
# The production overlay sets the vLLM endpoints + model names inline, so you only
# need to provide the secrets, domain, and public URLs here.

# =============================================================================
# ENVIRONMENT
# =============================================================================
# MUST be "production" — this makes the app fail-fast if a required secret is unset.
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# SECRETS (REQUIRED — no defaults in production)
# =============================================================================
# Generate strong values, e.g.:  openssl rand -base64 24
NEO4J_PASSWORD=CHANGE_ME_strong_neo4j_password
GRAFANA_PASSWORD=CHANGE_ME_strong_grafana_password

# =============================================================================
# DOMAIN + PUBLIC URLS (Gate 6 — Caddy + Let's Encrypt)
# =============================================================================
# Single subdomain, PATH-BASED routing — only ONE A-record is needed:
#   aiops.imaginaerium.in -> 203.0.113.10   (see aws/HOSTINGER_DNS_SETUP.md)
# Caddy serves /, /api, /ws, /grafana and /ingest from this one host + one cert.
APP_DOMAIN=aiops.imaginaerium.in

# Let's Encrypt contact address (cert-expiry notices).
ACME_EMAIL=you@example.com

# Absolute same-origin API base the SPA calls, baked in as VITE_API_URL at build.
# MUST end in /api/v1 (the client appends resource paths). Leave BLANK to fall
# back to a relative /api/v1 (recommended — keeps the bundle domain-portable).
PUBLIC_API_URL=https://aiops.imaginaerium.in/api/v1

# Origins the API's CORS layer accepts (comma-separated). Same-origin behind Caddy
# does not strictly need this, but keep the HTTPS domain for any direct API tools.
CORS_ORIGINS=https://aiops.imaginaerium.in

# -----------------------------------------------------------------------------
# Caddy human basic-auth — gates the whole app (Grafana keeps its own login too).
# Generate the bcrypt hash with:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'your-pass'
# IMPORTANT: a bcrypt hash contains '$' — escape EVERY '$' as '$$' on the HASH
# line below, or docker-compose mangles it during interpolation.
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_HASH=CHANGE_ME_bcrypt_hash_with_every_dollar_escaped_as_double_dollar

# App-layer token guarding the public WebSocket (/ws). Caddy can't basic_auth the
# WS upgrade, so set a long random value here; the SPA fetches it from the authed
# /api/v1/ws/token endpoint and sends it on the WS connection. Leave empty to allow
# unauthenticated WS (local/dev only).
WS_TOKEN=

# =============================================================================
# REMOTE-MONITORING INGESTION (Gate 7 — Caddy basic-auth on /ingest/*)
# =============================================================================
# The edge Alloy agent (monitoring-agent/, runs on the REMOTE host) pushes
# logs/metrics/traces to https://aiops.imaginaerium.in/ingest/* over TLS using
# this machine credential. The PLAINTEXT password goes into monitoring-agent/.env;
# the BCRYPT hash (same '$$' escaping rule as above) is what Caddy verifies here.
INGEST_BASIC_AUTH_USER=edge
INGEST_BASIC_AUTH_HASH=CHANGE_ME_bcrypt_hash_with_every_dollar_escaped_as_double_dollar

# =============================================================================
# HOST / LOGS (promtail -> Loki)
# =============================================================================
# promtail ships container logs to Loki by reading the host's Docker json-log
# files. Set this to the host's Docker data-root if it was relocated off the
# stock path (this VM keeps Docker on the EBS volume at /mnt/docker). If unset,
# it defaults to /var/lib/docker. Find it with:  docker info | grep "Root Dir"
DOCKER_DATA_ROOT=/mnt/docker
