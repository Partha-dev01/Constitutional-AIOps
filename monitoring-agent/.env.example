# Constitutional AIOps — edge agent credentials + endpoints.
# Copy to .env (gitignored) on the REMOTE host and fill in real values.

# A short, stable name for THIS host/environment. Stamped onto every log line,
# metric series and trace as the `edge` label so the backend + Grafana can tell
# multiple monitored hosts apart.
EDGE_LABEL=remote-host-1

# Machine credential for the /ingest/* basic_auth. The PLAINTEXT pair lives here;
# the server admin stores the matching BCRYPT hash in the AWS-side .env.production
# (INGEST_BASIC_AUTH_USER / INGEST_BASIC_AUTH_HASH). Username must match.
INGEST_USER=edge
INGEST_PASS=CHANGE_ME_match_the_server_ingest_password

# Public ingestion endpoints (single host, path-routed). Replace the domain only
# if you are not using aiops.example.com. The path tails below are required.
LOKI_PUSH_URL=https://aiops.example.com/ingest/loki/loki/api/v1/push
PROM_RW_URL=https://aiops.example.com/ingest/prom/api/v1/write
OTLP_HTTP_URL=https://aiops.example.com/ingest/otlp
