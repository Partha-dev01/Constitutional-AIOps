# Constitutional AIOps - Environment Configuration
# Copy this file to .env and edit as needed

# =============================================================================
# ENVIRONMENT
# =============================================================================

# Environment type: local, gpu-testing, production
ENVIRONMENT=local

# Debug mode (enables verbose logging)
DEBUG=false

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# llama-swap endpoint
OPENAI_API_BASE=http://localhost:8080/v1

# Model names (must match llama-swap config)
FAST_MODEL=fast-agent
REASONING_MODEL=reasoning-agent

# Model timeout (seconds before 14B unloads)
MODEL_TIMEOUT_SECONDS=60

# =============================================================================
# CONFIDENCE THRESHOLDS
# =============================================================================

# Confidence >= HIGH: Automatic action
CONFIDENCE_HIGH=0.9

# Confidence >= MEDIUM: Requires approval
# Confidence < MEDIUM: Alert only
CONFIDENCE_MEDIUM=0.7

# =============================================================================
# NEO4J (Graph Memory)
# =============================================================================

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# =============================================================================
# INFLUXDB (Time Series)
# =============================================================================

INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=aiops
INFLUXDB_BUCKET=telemetry

# =============================================================================
# TELEMETRY SOURCES
# =============================================================================

LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
PROMETHEUS_URL=http://localhost:9090

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: json, console
LOG_FORMAT=console

# =============================================================================
# SECURITY (Production Only)
# =============================================================================

# JWT secret for API authentication (CHANGE IN PRODUCTION!)
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# API key for service-to-service communication
API_KEY=

# =============================================================================
# AWS CONFIGURATION (For GPU Testing)
# =============================================================================

# AWS instance ID for start/stop scripts
AWS_INSTANCE_ID=

# AWS region
AWS_REGION=us-east-1

# SSH key file path
SSH_KEY_FILE=~/.ssh/aiops-key.pem
