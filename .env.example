# Constitutional AIOps - Environment Configuration (template)
# Copy to .env and edit. Real secrets must NEVER be committed (.env is gitignored).

# =============================================================================
# ENVIRONMENT
# =============================================================================

# local | gpu-testing | production
ENVIRONMENT=local
DEBUG=true

# =============================================================================
# API CONFIGURATION
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# =============================================================================
# LLM CONFIGURATION — bring your own OpenAI-compatible endpoint
# =============================================================================
# Works with vLLM, Ollama, AWS Bedrock (/openai/v1), OpenAI, or any
# OpenAI-compatible server. Both agents MAY point at the SAME URL + model for a
# minimal single-endpoint setup, or at two endpoints for the dual-engine
# reference config. Colon-free model names auto-disable "thinking"; Ollama names
# with a colon (qwen3:4b) keep it on. A trailing slash on *_URL is optional.

FAST_AGENT_URL=http://localhost:8000/v1
REASONING_AGENT_URL=http://localhost:8001/v1

FAST_AGENT_MODEL=qwen3-4b
REASONING_AGENT_MODEL=qwen3-14b

# Bearer token for a secured endpoint (optional; empty = no Authorization header).
# LLM_API_KEY covers both agents; the per-agent keys override it if set.
LLM_API_KEY=
# FAST_AGENT_API_KEY=
# REASONING_AGENT_API_KEY=

FAST_AGENT_TIMEOUT=120
REASONING_AGENT_TIMEOUT=180

# =============================================================================
# CONFIDENCE THRESHOLDS
# =============================================================================

CONFIDENCE_THRESHOLD_AUTO=0.90
CONFIDENCE_THRESHOLD_APPROVAL=0.70

# =============================================================================
# NEO4J (Graph Memory) — full stack only
# =============================================================================
# The lite profile (docker-compose.lite.yml) runs WITHOUT Neo4j and falls back
# to an in-memory episode store, so a dummy password is fine there. The full
# GPU stack REQUIRES a strong value (no built-in default).

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword

# =============================================================================
# TELEMETRY SOURCES (LGTM stack)
# =============================================================================

LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
PROMETHEUS_URL=http://localhost:9090

# =============================================================================
# CORS (comma-separated origins the API will accept)
# =============================================================================

CORS_ORIGINS=http://localhost:3000

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=console
