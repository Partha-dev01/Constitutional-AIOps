# Constitutional AIOps - Environment Configuration (template)
# Copy to .env and edit. Real secrets must NEVER be committed (.env is gitignored).

# =============================================================================
# ENVIRONMENT
# =============================================================================

# local | gpu-testing | production
ENVIRONMENT=local
DEBUG=true

# =============================================================================
# API CONFIGURATION
# =============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Production (AWS) uses on-VM vLLM AWQ; the served-model-names are colon-free
# ("qwen3-4b" / "qwen3-14b") so ModelRouter auto-sends enable_thinking=false.
#
# For LOCAL dev without a GPU you can point these at a remote Ollama endpoint
# (e.g. Jarvis Labs) instead — those model names use a colon (qwen3:4b-instruct).

FAST_AGENT_URL=http://localhost:8000/v1
REASONING_AGENT_URL=http://localhost:8001/v1

FAST_AGENT_MODEL=qwen3-4b
REASONING_AGENT_MODEL=qwen3-14b

FAST_AGENT_TIMEOUT=120
REASONING_AGENT_TIMEOUT=180

# =============================================================================
# CONFIDENCE THRESHOLDS
# =============================================================================

CONFIDENCE_THRESHOLD_AUTO=0.90
CONFIDENCE_THRESHOLD_APPROVAL=0.70

# =============================================================================
# NEO4J (Graph Memory)
# =============================================================================
# REQUIRED in production (no built-in default). Set a strong value.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword

# =============================================================================
# TELEMETRY SOURCES (LGTM stack)
# =============================================================================

LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
PROMETHEUS_URL=http://localhost:9090

# =============================================================================
# CORS (comma-separated origins the API will accept)
# =============================================================================

CORS_ORIGINS=http://localhost:3000

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=console
