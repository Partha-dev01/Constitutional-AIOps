# Git LFS: large binary artifacts only
# Curated benchmark JSONs (~1.5MB total) stay in plain git for diffability.
# Raw datasets (5.5GB LEMMA-RCA) stay OUTSIDE the repo entirely.
# This file only marks files that ARE binary and may exceed plain-git friendly size.

*.dump filter=lfs diff=lfs merge=lfs -text
*.neo4j-dump filter=lfs diff=lfs merge=lfs -text
graph-snapshots/*.dump filter=lfs diff=lfs merge=lfs -text
benchmark/archive/results_local/**/raw_traces.jsonl filter=lfs diff=lfs merge=lfs -text
# Legacy path (pre-2026-05-20 reorg): benchmark/results/**/raw_traces.jsonl

# Line-endings hygiene (single team, mixed OS - Windows + Linux on AWS VM)
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
